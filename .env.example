# Copie ce fichier en ".env" (jamais commité) ou mets ces
# variables dans Cloud Run > Modifier et déployer > Variables et secrets.

# OBLIGATOIRES — developers.tiktok.com > ton app > Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# FACULTATIVES
# Par défaut : https://<domaine du site>/auth/tiktok/callback
# TIKTOK_REDIRECT_URI=https://tiktok-tracker.cloud.run/auth/tiktok/callback
# Par défaut : dérivé de TIKTOK_CLIENT_SECRET
# SESSION_SECRET=
# Mettre 0 pour ne jamais appeler tikwm
# TIKWM_ENABLED=1
