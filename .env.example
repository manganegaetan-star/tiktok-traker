# Copie ce fichier en ".env" (jamais commité) ou mets ces
# variables dans Cloud Run > Modifier > Variables et secrets.

# developers.tiktok.com > ton app > Login Kit + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Doit être EXACTEMENT celle déclarée dans l'app TikTok
TIKTOK_REDIRECT_URI=https://TON-SITE/auth/tiktok/callback

# 32+ caractères aléatoires (chiffre les cookies de connexion)
# Génère-en un avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Mettre 0 pour ne jamais appeler tikwm (suivi public)
TIKWM_ENABLED=1
